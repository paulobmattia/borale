# ==============================================================================
# BORALÊ — VARIÁVEIS DE AMBIENTE (MODELO)
# Configure estas variáveis no seu arquivo .env.local e nas configurações da Vercel
# ==============================================================================

# Supabase (Banco de Dados, Autenticação e Storage)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL Base da Aplicação (ex: https://borale.vercel.app em produção)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense (Opcional - fornecido pelo painel do Google AdSense)
# Deixe em branco caso ainda esteja aguardando aprovação do Google.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_ID=XXXXXXXXXX
