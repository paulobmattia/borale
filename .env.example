# ==============================================================================
# BORALÊ — VARIÁVEIS DE AMBIENTE (.env.local)
# ==============================================================================

# 1. Credenciais do Projeto Supabase
# Obtidas em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui

# 2. URL Base da Aplicação (usada para redirecionamento OAuth e links absolutos)
# Em ambiente de desenvolvimento local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Em ambiente de produção (Vercel/Domínio Próprio):
# NEXT_PUBLIC_SITE_URL=https://borale.app
